{
  "name": "virtbase-bookkeeping",
  "version": "0.4.0",
  "description": "Local bookkeeping app that fetches Stripe and Monero transactions and exports Lexware Office CSV files.",
  "keywords": [
    "bookkeeping",
    "stripe",
    "monero",
    "lexware",
    "csv",
    "accounting"
  ],
  "homepage": "https://virtbase.com",
  "bugs": {
    "url": "https://github.com/virtbase/virtbase-bookkeeping/issues",
    "email": "support@virtbase.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/virtbase/virtbase-bookkeeping.git"
  },
  "license": "MIT",
  "author": "BeastHost UG (haftungsbeschränkt) <support@virtbase.com>",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": ">=1.4.3"
  },
  "scripts": {
    "start": "bun scripts/fetch-monero.ts && vite build && bun src/server/index.ts",
    "dev": "bun scripts/fetch-monero.ts && bun run --parallel dev:web dev:server",
    "dev:web": "vite build --watch",
    "dev:server": "bun --watch src/server/index.ts",
    "build": "vite build",
    "compile": "bun scripts/compile.ts",
    "package": "bun scripts/package.ts",
    "package:deb": "bun scripts/package.ts deb-amd64",
    "package:smoke": "bun scripts/smoke-test.ts",
    "monero:update": "bun scripts/monero-update.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test tests",
    "check": "biome check .",
    "check:write": "biome check --write .",
    "check:ci": "biome ci --config-path=biome.ci.json .",
    "verify": "bun run check && bun run typecheck && bun run test",
    "prepare": "husky"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "lint-staged": {
    "*": "biome check --write --no-errors-on-unmatched --files-ignore-unknown=true"
  },
  "dependencies": {
    "@daypicker/react": "10.0.2",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@hookform/resolvers": "7.0.3",
    "@tanstack/react-table": "9.3.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.16",
    "lucide-react": "1.69.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.91.0",
    "recharts": "3.10.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@tailwindcss/vite": "4.3.4",
    "@types/bun": "1.4.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "oxc-transform-react": "0.156.0",
    "tailwindcss": "4.3.4",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "vite": "8.3.6"
  }
}
